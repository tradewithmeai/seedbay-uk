# Where the build reads listings from when pre-rendering pages.
# Defaults to https://seedbay.co.uk when unset, which is what CI uses.
# Point it at a local PHP server to build against local data.
SEEDBAY_API_BASE=https://seedbay.co.uk

# Alternative for building with no API at all: a JSON array of seed rows.
# SEEDBAY_FIXTURE=./fixtures/seeds.json
